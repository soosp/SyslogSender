{
  // Host tests without hardware. Ctrl+Shift+B (Run Build Task) and pick
  // "Run SyslogSender tests". Assumes the library root is the workspace folder.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run SyslogSender tests",
      "type": "shell",
      "command": "./run_tests.sh",
      "windows": { "command": "cmd.exe", "args": ["/c", "run_tests.bat", "nopause"] },
      "options": {
        "cwd": "${workspaceFolder}/test",
        "env": { "PATH": "C:\\msys64\\ucrt64\\bin;C:\\msys64\\usr\\bin;${env:PATH}" }
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ]
}
